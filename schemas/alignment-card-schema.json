{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aap.dev/schemas/alignment-card-v1.json",
  "title": "Alignment Card",
  "description": "Declares an agent's alignment properties (extends A2A Agent Card)",
  "type": "object",
  "properties": {
    "principal": {
      "type": "object",
      "description": "Who the agent serves",
      "properties": {
        "type": { "type": "string", "enum": ["human", "organization", "agent"] },
        "relationship": { "type": "string" }
      },
      "required": ["type", "relationship"]
    },
    "autonomy_envelope": {
      "type": "object",
      "description": "What the agent can do independently",
      "properties": {
        "bounded_actions": { "type": "array", "items": { "type": "string" } },
        "escalation_triggers": { "type": "array", "items": { "type": "string" } },
        "max_autonomous_value": { "type": "number" }
      }
    },
    "audit_commitment": {
      "type": "object",
      "description": "How decisions are logged",
      "properties": {
        "trace_format": { "type": "string" },
        "queryable": { "type": "boolean" },
        "retention_days": { "type": "integer" }
      }
    },
    "values": {
      "type": "object",
      "description": "What the agent optimizes for",
      "properties": {
        "declared": { "type": "array", "items": { "type": "string" } },
        "conflicts_with": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "required": ["principal", "values"]
}
