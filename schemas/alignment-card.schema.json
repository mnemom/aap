{
  "$defs": {
    "AuditCommitment": {
      "description": "Audit trail commitments (SPEC Section 4.7).",
      "properties": {
        "trace_format": {
          "default": "ap-trace-v1",
          "description": "Trace format identifier",
          "title": "Trace Format",
          "type": "string"
        },
        "retention_days": {
          "description": "Minimum retention period in days",
          "minimum": 1,
          "title": "Retention Days",
          "type": "integer"
        },
        "storage": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuditStorage"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Storage configuration"
        },
        "queryable": {
          "description": "Whether traces can be queried externally",
          "title": "Queryable",
          "type": "boolean"
        },
        "query_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Endpoint for trace queries (required if queryable=true)",
          "title": "Query Endpoint"
        },
        "tamper_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/TamperEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tamper-evidence mechanism"
        }
      },
      "required": [
        "retention_days",
        "queryable"
      ],
      "title": "AuditCommitment",
      "type": "object"
    },
    "AuditStorage": {
      "description": "Audit log storage configuration.",
      "properties": {
        "type": {
          "$ref": "#/$defs/StorageType",
          "description": "Storage type"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Storage endpoint or location",
          "title": "Location"
        }
      },
      "required": [
        "type"
      ],
      "title": "AuditStorage",
      "type": "object"
    },
    "AutonomyEnvelope": {
      "description": "Autonomy bounds and escalation triggers (SPEC Section 4.5).",
      "properties": {
        "bounded_actions": {
          "description": "Actions permitted without escalation",
          "items": {
            "type": "string"
          },
          "title": "Bounded Actions",
          "type": "array"
        },
        "escalation_triggers": {
          "description": "Conditions requiring escalation",
          "items": {
            "$ref": "#/$defs/EscalationTrigger"
          },
          "title": "Escalation Triggers",
          "type": "array"
        },
        "max_autonomous_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/MonetaryValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum transaction value without escalation"
        },
        "forbidden_actions": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Actions never permitted",
          "title": "Forbidden Actions"
        }
      },
      "required": [
        "bounded_actions",
        "escalation_triggers"
      ],
      "title": "AutonomyEnvelope",
      "type": "object"
    },
    "EscalationTrigger": {
      "description": "Condition that triggers escalation (SPEC Section 4.5).",
      "properties": {
        "condition": {
          "description": "Condition expression (see SPEC Section 4.6)",
          "title": "Condition",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/TriggerAction",
          "description": "Action to take when trigger matches"
        },
        "reason": {
          "description": "Human-readable explanation",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "condition",
        "action",
        "reason"
      ],
      "title": "EscalationTrigger",
      "type": "object"
    },
    "HierarchyType": {
      "description": "How value conflicts are resolved.",
      "enum": [
        "lexicographic",
        "weighted",
        "contextual"
      ],
      "title": "HierarchyType",
      "type": "string"
    },
    "MonetaryValue": {
      "description": "Monetary value specification.",
      "properties": {
        "amount": {
          "description": "Numeric amount",
          "title": "Amount",
          "type": "number"
        },
        "currency": {
          "default": "USD",
          "description": "ISO 4217 currency code",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount"
      ],
      "title": "MonetaryValue",
      "type": "object"
    },
    "Principal": {
      "description": "Principal relationship declaration (SPEC Section 4.3).",
      "properties": {
        "type": {
          "$ref": "#/$defs/PrincipalType",
          "description": "Type of principal"
        },
        "identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Principal identifier (DID, email, org ID)",
          "title": "Identifier"
        },
        "relationship": {
          "$ref": "#/$defs/RelationshipType",
          "description": "Nature of authority delegation"
        },
        "escalation_contact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Endpoint for escalation notifications",
          "title": "Escalation Contact"
        }
      },
      "required": [
        "type",
        "relationship"
      ],
      "title": "Principal",
      "type": "object"
    },
    "PrincipalType": {
      "description": "Type of principal the agent serves.",
      "enum": [
        "human",
        "organization",
        "agent",
        "unspecified"
      ],
      "title": "PrincipalType",
      "type": "string"
    },
    "RelationshipType": {
      "description": "Nature of authority delegation from principal to agent.",
      "enum": [
        "delegated_authority",
        "advisory",
        "autonomous"
      ],
      "title": "RelationshipType",
      "type": "string"
    },
    "StorageType": {
      "description": "Audit log storage type.",
      "enum": [
        "local",
        "remote",
        "distributed"
      ],
      "title": "StorageType",
      "type": "string"
    },
    "TamperEvidence": {
      "description": "Tamper-evidence mechanism for audit logs.",
      "enum": [
        "append_only",
        "signed",
        "merkle"
      ],
      "title": "TamperEvidence",
      "type": "string"
    },
    "TriggerAction": {
      "description": "Action to take when escalation trigger matches.",
      "enum": [
        "escalate",
        "deny",
        "log"
      ],
      "title": "TriggerAction",
      "type": "string"
    },
    "ValueDefinition": {
      "description": "Definition of a custom value.",
      "properties": {
        "name": {
          "description": "Human-readable name",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "description": "What this value means operationally",
          "title": "Description",
          "type": "string"
        },
        "priority": {
          "default": 0,
          "description": "Priority for lexicographic ordering (higher = more important)",
          "title": "Priority",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "ValueDefinition",
      "type": "object"
    },
    "Values": {
      "description": "Value declarations (SPEC Section 4.4).",
      "properties": {
        "declared": {
          "description": "List of value identifiers",
          "items": {
            "type": "string"
          },
          "title": "Declared",
          "type": "array"
        },
        "definitions": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/ValueDefinition"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Definitions for non-standard values",
          "title": "Definitions"
        },
        "conflicts_with": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Values this agent refuses to coordinate with",
          "title": "Conflicts With"
        },
        "hierarchy": {
          "anyOf": [
            {
              "$ref": "#/$defs/HierarchyType"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How value conflicts are resolved"
        }
      },
      "required": [
        "declared"
      ],
      "title": "Values",
      "type": "object"
    }
  },
  "description": "Alignment Card \u2014 Agent alignment declaration (SPEC Section 4).\n\nA structured document declaring an agent's alignment posture. It MUST be\nmachine-readable (JSON) and SHOULD be human-readable.\n\nExample:\n    card = AlignmentCard(\n        aap_version=\"0.1.0\",\n        card_id=\"ac-12345\",\n        agent_id=\"did:web:agent.example.com\",\n        issued_at=datetime.utcnow(),\n        principal=Principal(type=PrincipalType.HUMAN, relationship=RelationshipType.DELEGATED_AUTHORITY),\n        values=Values(declared=[\"principal_benefit\", \"transparency\"]),\n        autonomy_envelope=AutonomyEnvelope(\n            bounded_actions=[\"search\", \"recommend\"],\n            escalation_triggers=[\n                EscalationTrigger(\n                    condition='action_type == \"purchase\"',\n                    action=TriggerAction.ESCALATE,\n                    reason=\"Purchases require approval\",\n                )\n            ],\n        ),\n        audit_commitment=AuditCommitment(\n            retention_days=90,\n            queryable=True,\n            query_endpoint=\"https://agent.example.com/api/traces\",\n        ),\n    )",
  "properties": {
    "aap_version": {
      "default": "0.1.0",
      "description": "AAP specification version",
      "title": "Aap Version",
      "type": "string"
    },
    "card_id": {
      "description": "Unique identifier for this card (UUID or URI)",
      "title": "Card Id",
      "type": "string"
    },
    "agent_id": {
      "description": "Identifier for the agent (DID, URL, or UUID)",
      "title": "Agent Id",
      "type": "string"
    },
    "issued_at": {
      "description": "When this card was issued",
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "When this card expires",
      "title": "Expires At"
    },
    "principal": {
      "$ref": "#/$defs/Principal",
      "description": "Principal relationship declaration"
    },
    "values": {
      "$ref": "#/$defs/Values",
      "description": "Value declarations"
    },
    "autonomy_envelope": {
      "$ref": "#/$defs/AutonomyEnvelope",
      "description": "Autonomy bounds and escalation triggers"
    },
    "audit_commitment": {
      "$ref": "#/$defs/AuditCommitment",
      "description": "Audit trail commitments"
    },
    "extensions": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Protocol-specific extensions",
      "title": "Extensions"
    }
  },
  "required": [
    "card_id",
    "agent_id",
    "issued_at",
    "principal",
    "values",
    "autonomy_envelope",
    "audit_commitment"
  ],
  "title": "AlignmentCard",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aap.dev/schemas/alignment-card-v1.json"
}